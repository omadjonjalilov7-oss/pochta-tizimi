# Ma'lumotlar bazasi (PostgreSQL)
# Format: postgresql://USER:PAROL@HOST:PORT/BAZA_NOMI?schema=public
DATABASE_URL="postgresql://pochta_user:Pochta_DB_2026@localhost:5432/pochta?schema=public"

# Server porti
PORT=3000

# JWT secret — bu uzun, tasodifiy satr bo'lishi kerak (eslab qolish shart emas, generatsiya qiling)
# Generatsiya: PowerShell'da: [Convert]::ToBase64String((1..48 | %{Get-Random -Maximum 256}))
JWT_SECRET="ALMASHTIRING_BU_QATORNI_TASODIFIY_UZUN_SATRGA"
JWT_EXPIRES_IN="12h"
JWT_REMEMBER_EXPIRES_IN="30d"

# Fayllarni saqlash papkasi
ATTACHMENTS_DIR="C:\\D\\pochta\\storage\\attachments"
MAX_FILE_SIZE_MB=50
MAX_TOTAL_FILE_SIZE_MB=200

# CORS — frontend manzili
FRONTEND_URL="http://localhost:5173"

# Bcrypt
BCRYPT_ROUNDS=12

# Rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
