// Prisma schema — Korporativ pochta tizimi
// Hujjat: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// BO'LIMLAR
// ============================================================
model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(255)
  // Hujjat raqamlash uchun bo'lim kodi (masalan: "001", "002"). Admin tomonidan beriladi.
  code      String?  @unique @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]
  numberedDocuments Document[] @relation("DocNumberDept")
  targetedDocuments Document[] @relation("DocTargetDept")

  @@map("departments")
}

// ============================================================
// LAVOZIMLAR
// ============================================================
model Position {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(255)
  rank      Int      @default(100) // kichik = yuqori (1=Direktor)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]

  @@index([rank])
  @@map("positions")
}

// ============================================================
// FOYDALANUVCHILAR
// ============================================================

// EDO ro'llari:
//  admin       — barcha hujjatlar + foydalanuvchi/tizim sozlamalari
//  chancellery — konselyariya: barcha hujjatlar, taxrir tarixi, hisobotlar, holatlar (foydalanuvchi sozlamasi YO'Q)
//  user        — faqat o'zi ishtirok etgan hujjatlar + faqat o'z profili
enum UserRole {
  admin
  chancellery
  user
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  login            String   @unique @db.VarChar(64)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  fullName        String   @map("full_name") @db.VarChar(255)
  phone           String?  @db.VarChar(32)
  email           String?  @unique @db.VarChar(255)
  avatarPath      String?  @map("avatar_path") @db.VarChar(512)

  departmentId    String?  @map("department_id") @db.Uuid
  positionId      String?  @map("position_id") @db.Uuid

  // Bevosita rahbar — EDO uchun imzo zanjirini qurish va vazifa biriktirishda ishlatiladi
  managerId       String?  @map("manager_id") @db.Uuid

  canSendExternal Boolean  @default(false) @map("can_send_external")
  // EDO: tashqi yuboriladigan hujjatlarni E-IMZO bilan imzolash huquqi (faqat tor doiradagi xodimlar)
  canSignExternal Boolean  @default(false) @map("can_sign_external")
  isActive        Boolean  @default(true) @map("is_active")
  // Maxfiy login: bu foydalanuvchi oddiy xodimlarga ro'yxatlarda ko'rinmaydi
  isProtected     Boolean  @default(false) @map("is_protected")
  // Maxfiy loginlarni ko'ra oladimi (admin yoqib qo'yadi)
  canSeeProtected Boolean  @default(false) @map("can_see_protected")
  // LEGACY: role kiritilgandan keyin faqat migratsiya uchun saqlanadi (keyingi bosqichda o'chiriladi)
  isAdmin         Boolean  @default(false) @map("is_admin")
  role            UserRole @default(user) @map("role")

  failedLoginCount Int      @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(3)

  // Tashqi pochta (asaka-motors.uz) integratsiyasi
  externalMailLogin       String?   @map("external_mail_login") @db.VarChar(255)
  externalMailPasswordEnc String?   @map("external_mail_password_enc") @db.Text
  externalMailEnabled     Boolean   @default(false) @map("external_mail_enabled")
  externalMailLastSyncAt  DateTime? @map("external_mail_last_sync_at") @db.Timestamptz(3)
  externalMailLastUid     Int?      @map("external_mail_last_uid")

  // EDO bildirishnomalari (yangi hujjat, vazifa, deadline) — Pochta xabari ko'rinishida
  notifyEdo               Boolean   @default(true) @map("notify_edo")

  // EDO tasdiqlash PIN-kodi (4 xona) — faqat hujjatni tasdiqlash/rad etish/yuborish payti so'raladi
  approvalPinHash         String?   @map("approval_pin_hash") @db.VarChar(255)

  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position        Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)

  // Bevosita rahbar (o'zaro munosabat)
  manager         User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates    User[]  @relation("UserManager")

  sentMessages    Message[]            @relation("MessageSender")
  receivedItems   MessageRecipient[]
  auditLogs       AuditLog[]

  // Muddati o'tgan hujjatlarning director tasdiqlovchilari
  overdueApprovals Document[] @relation("DocOverdueApprover")

  // Direkt chat
  chatSent        ChatMessage[] @relation("ChatSender")
  chatReceived    ChatMessage[] @relation("ChatReceiver")

  // Guruh chat
  ownedChatGroups    ChatGroup[]        @relation("ChatGroupOwner")
  chatGroupMembers   ChatGroupMember[]
  chatGroupMessages  ChatGroupMessage[] @relation("ChatGroupSender")

  // Kontakt guruhlari (foydalanuvchi o'zi yaratgan guruhlar)
  ownedContactGroups      ContactGroup[]       @relation("ContactGroupOwner")
  groupMemberships        ContactGroupMember[] @relation("GroupMember")

  // EDO munosabatlari
  createdDocuments         Document[]            @relation("DocCreator")
  heldDocuments            Document[]            @relation("DocHolder")
  documentParticipations   DocumentParticipant[]
  authoredResolutions      Resolution[]
  resolutionTargets        ResolutionTarget[]
  documentComments         DocumentComment[]
  documentSignatures       DocumentSignature[]
  documentTemplatesAuthored DocumentTemplate[]
  uploadedDocAttachments   DocumentAttachment[]
  edoAuditLogs             DocumentAuditLog[]

  // Xabar o'qish jurnali
  messageReadLogs          MessageReadLog[] @relation("ReadLogs")

  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@index([isActive])
  @@map("users")
}

// ============================================================
// XABARLAR (asosiy)
// ============================================================
enum Importance {
  normal
  important
  urgent
}

model Message {
  id          String     @id @default(uuid()) @db.Uuid
  fromUserId  String?    @map("from_user_id") @db.Uuid
  subject     String     @db.VarChar(512)
  body        String     @db.Text
  importance  Importance @default(normal)
  isExternal  Boolean    @default(false) @map("is_external")
  sentAt      DateTime   @default(now()) @map("sent_at") @db.Timestamptz(3)
  recalledAt  DateTime?  @map("recalled_at") @db.Timestamptz(3)

  // Tashqi pochta (IMAP orqali kelgan xabarlar uchun)
  externalFromEmail String? @map("external_from_email") @db.VarChar(255)
  externalFromName  String? @map("external_from_name") @db.VarChar(255)
  externalMessageId String? @map("external_message_id") @db.VarChar(512)
  externalImapUid   Int?    @map("external_imap_uid")

  // Tashqi pochta (SMTP orqali yuborilgan xabarlar uchun — qabul qiluvchilar)
  externalToEmails  String[] @default([]) @map("external_to_emails")
  externalCcEmails  String[] @default([]) @map("external_cc_emails")

  fromUser    User?                 @relation("MessageSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  recipients  MessageRecipient[]
  attachments Attachment[]
  externalReceipts ExternalReadReceipt[]
  readLogs    MessageReadLog[]

  @@index([fromUserId])
  @@index([sentAt])
  @@index([externalMessageId])
  @@map("messages")
}

// ============================================================
// TASHQI O'QISH KVITANSIYASI — tracking pixel orqali
// ============================================================
model ExternalReadReceipt {
  id            String    @id @default(uuid()) @db.Uuid
  messageId     String    @map("message_id") @db.Uuid
  email         String    @db.VarChar(255)
  trackToken    String    @unique @map("track_token") @db.VarChar(128)
  readLinkToken String?   @unique @map("read_link_token") @db.VarChar(128)
  readAt        DateTime? @map("read_at") @db.Timestamptz(3)
  readMethod    String?   @map("read_method") @db.VarChar(20) // 'pixel', 'header', 'link', 'imap'
  readIp        String?   @map("read_ip") @db.VarChar(64)
  readUserAgent String?   @map("read_user_agent") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([readLinkToken])
  @@map("external_read_receipts")
}

// ============================================================
// QABUL QILUVCHILAR (har bir xabar uchun har bir qabul qiluvchi alohida yozuv)
// Bu yondashuv "ko'pdan-ko'p" munosabat va har bir qabul qiluvchining alohida holatini saqlash imkonini beradi
// ============================================================
enum MessageFolder {
  inbox
  sent
  trash
  archive
}

enum RecipientKind {
  to
  cc
}

model MessageRecipient {
  id         String        @id @default(uuid()) @db.Uuid
  messageId  String        @map("message_id") @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  folder     MessageFolder @default(inbox)
  kind       RecipientKind @default(to)
  isRead     Boolean       @default(false) @map("is_read")
  readAt     DateTime?     @map("read_at") @db.Timestamptz(3)
  isStarred  Boolean       @default(false) @map("is_starred")
  deletedAt  DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, folder])
  @@index([userId, isRead])
  @@map("message_recipients")
}

// ============================================================
// FAYL BIRIKMALARI
// ============================================================
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String?  @map("message_id") @db.Uuid // xabar yuborilgunga qadar null
  uploadedBy   String   @map("uploaded_by") @db.Uuid
  filename     String   @db.VarChar(512)
  storedPath   String   @map("stored_path") @db.VarChar(1024)
  sizeBytes    BigInt   @map("size_bytes")
  mimeType     String   @map("mime_type") @db.VarChar(128)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploadedBy])
  @@map("attachments")
}

// ============================================================
// AUDIT LOG (kim qachon nima qildi)
// ============================================================
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(64)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================================
// ARXIV — eski xabarlar (6 oydan keyin shu yerga ko'chiriladi)
// Sxema messages bilan bir xil, lekin alohida jadval — asosiy jadval kichik qoladi va tezroq ishlaydi
// ============================================================
model MessageArchive {
  id          String     @id @db.Uuid
  fromUserId  String     @map("from_user_id") @db.Uuid
  subject     String     @db.VarChar(512)
  body        String     @db.Text
  importance  Importance @default(normal)
  isExternal  Boolean    @default(false) @map("is_external")
  sentAt      DateTime   @map("sent_at") @db.Timestamptz(3)
  archivedAt  DateTime   @default(now()) @map("archived_at") @db.Timestamptz(3)
  recipientsJson Json    @map("recipients_json")
  attachmentsJson Json   @map("attachments_json")

  @@index([fromUserId])
  @@index([sentAt])
  @@map("messages_archive")
}

// ============================================================
// XABAR O'QISH JURNALI — Ichki foydalanuvchilarning xabar o'qish tarixi
// O'qish surtasatini kuzatish uchun. Tarqalgan/kopirlangan xabarlar uchun.
// ============================================================
model MessageReadLog {
  id            String    @id @default(uuid()) @db.Uuid
  messageId     String    @map("message_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  readAt        DateTime  @map("read_at") @db.Timestamptz(3)
  readMethod    String?   @map("read_method") @db.VarChar(20)  // 'opened', 'auto_marked', 'manual'
  readIp        String?   @map("read_ip") @db.VarChar(45)      // IPv4 yoki IPv6
  readUserAgent String?   @map("read_user_agent") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("ReadLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, readAt]) // Bir xil vaqtda bir xil message'ni bir xil user ikki marta o'qimasin
  @@index([messageId])
  @@index([userId])
  @@index([readAt])
  @@index([messageId, readAt]) // Tez xisobot olish uchun
  @@map("message_read_logs")
}

// ============================================================
// TASHKILOTLAR — tashqi/kiruvchi hujjatlar uchun yuboruvchi/oluvchi tashkilotlar
// ============================================================
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  inn       String   @unique @db.VarChar(32)   // STIR/INN raqami — noyob
  address   String?  @db.VarChar(500)
  phone     String?  @db.VarChar(64)
  note      String?  @db.Text                  // qo'shimcha ma'lumot
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  senderDocuments Document[] @relation("DocSenderOrg")

  @@index([name])
  @@map("organizations")
}

// ============================================================
// EDO — HUJJAT AYLANMASI (Electronic Document Workflow)
// ============================================================

enum DocumentType {
  internal     // ichki hujjat (Pochta orqali xabar yuboriladi)
  incoming     // tashqaridan kelgan
  outgoing     // tashqariga yuboriladi (E-IMZO talab qilinadi)
}

enum DocumentStatus {
  draft        // loyiha — yaratuvchi hali yubormagan
  in_review    // rahbarlar imzo/tasdiqlash zanjirida
  in_progress  // rezolyutsiya yozildi, ijroda
  done         // bajarildi va yopildi
  rejected     // rad etildi
  overdue      // muddati o'tib ketdi (avtomatik holat)
}

enum ParticipantRole {
  creator      // yaratuvchi
  approver     // tasdiqlovchi — imzo zanjirida (rahbarlar, rais)
  executor     // ijrochi — rezolyutsiya bo'yicha vazifa beriladi
  observer     // ma'lumotga
}

enum ParticipantStatus {
  pending
  approved
  rejected
  done
}

enum EdoTaskStatus {
  pending
  in_progress
  done
  overdue
}

model Document {
  id              String          @id @default(uuid()) @db.Uuid
  number          String          @unique @db.VarChar(64)             // xodimlar uchun tartib raqami: tartib-bo'lim (masalan 01-05)
  docUid          String?         @unique @map("doc_uid") @db.VarChar(32) // tizim uchun yagona ID: asaka-YYYYMMDDNN
  numberCategory  String          @map("number_category") @db.VarChar(16)  // IN / OUT / INT / BUYRUQ
  // Ommaviy QR kod uchun tasodifiy token — login/parolsiz hujjat holatini ko'rish
  publicToken     String?         @unique @map("public_token") @db.VarChar(40)
  year            Int
  type            DocumentType
  internalKind    String?         @map("internal_kind") @db.VarChar(32)      // ichki hujjat turi: service_letter | order
  templateId      String?         @map("template_id") @db.Uuid
  subject         String          @db.VarChar(500)
  shortInfo       String?         @map("short_info") @db.VarChar(1000) // shapkada ko'rinadigan qisqa ma'lumot
  body            String          @db.Text
  status          DocumentStatus  @default(draft)

  // Tashqi yuborish bilan bog'liq
  isExternal        Boolean   @default(false) @map("is_external")
  externalRecipient String?   @map("external_recipient") @db.VarChar(255)
  // Kiruvchi/tashqi hujjat yuboruvchi tashkiloti (Organization)
  senderOrgId       String?   @map("sender_org_id") @db.Uuid

  createdById       String    @map("created_by_id") @db.Uuid
  currentHolderId   String?   @map("current_holder_id") @db.Uuid    // hozir kimda ko'rib chiqishda turibdi
  // Raqamlash uchun ishlatilgan bo'lim (odatda yaratuvchining bo'limi)
  numberDeptId      String?   @map("number_dept_id") @db.Uuid
  // Hujjat qaysi bo'limga yuborilayotgani (qabul qiluvchi bo'lim)
  targetDeptId      String?   @map("target_dept_id") @db.Uuid
  deadline          DateTime? @db.Timestamptz(3)

  // Yaratish formasidagi qo'shimcha maydonlar
  issueGroup             String?  @map("issue_group") @db.VarChar(255)            // Masalalar guruhi
  issues                 String?  @map("issues") @db.VarChar(255)                 // Masalalar
  tags                   String[] @map("tags")                                    // Hujjat heshteglari
  xdfuDsp                Boolean  @default(false) @map("xdfu_dsp")                 // XDFU / DSP rejimi
  qrLess                 Boolean  @default(false) @map("qr_less")                  // QR kodsiz yaratish
  deliverAsAppeal        Boolean  @default(false) @map("deliver_as_appeal")       // Qabul qiluvchiga murojaat sifatida yetkazish (outgoing)
  replyRequired          Boolean  @default(false) @map("reply_required")          // Javob xati talab qilinadi (outgoing)
  formApproversAfterSign Boolean  @default(false) @map("form_approvers_after_sign") // Imzodan so'ng kelishuvchilar ro'yxatini shakllantirish (internal)

  // Imzo zanjiri holati
  signatureChainPosition Int  @default(0) @map("signature_chain_position")
  isSigned               Boolean @default(false) @map("is_signed")

  // Hujjat chop qilishga tayyormi? (yakunlanmaguncha false)
  isPrintable            Boolean @default(false) @map("is_printable")

  // Muddati o'tgan hujjatlar uchun director tasdiq
  isOverdueApprovalRequired Boolean @default(false) @map("is_overdue_approval_required")
  overdueApprovedById       String? @map("overdue_approved_by_id") @db.Uuid
  overdueApprovedAt         DateTime? @map("overdue_approved_at") @db.Timestamptz(3)

  // Shablon tanlanmagan hujjatlar avtomat "ichki" shablonga solinadi. Bu bayroq
  // yoqilgan bo'lsa, hujjat ko'rsatilganda shablon jonli to'ldiriladi.
  autoFilled  Boolean   @default(false) @map("auto_filled")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(3)

  createdBy     User              @relation("DocCreator", fields: [createdById], references: [id])
  currentHolder User?             @relation("DocHolder", fields: [currentHolderId], references: [id], onDelete: SetNull)
  overdueApprovedBy User?          @relation("DocOverdueApprover", fields: [overdueApprovedById], references: [id], onDelete: SetNull)
  template      DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  numberDept    Department?       @relation("DocNumberDept", fields: [numberDeptId], references: [id], onDelete: SetNull)
  targetDept    Department?       @relation("DocTargetDept", fields: [targetDeptId], references: [id], onDelete: SetNull)
  senderOrg     Organization?     @relation("DocSenderOrg", fields: [senderOrgId], references: [id], onDelete: SetNull)

  participants DocumentParticipant[]
  resolutions  Resolution[]
  comments     DocumentComment[]
  attachments  DocumentAttachment[]
  signatures   DocumentSignature[]
  audit        DocumentAuditLog[]

  @@index([createdById])
  @@index([currentHolderId])
  @@index([status])
  @@index([type])
  @@index([year, numberCategory])
  @@map("documents")
}

model DocumentParticipant {
  id           String              @id @default(uuid()) @db.Uuid
  documentId   String              @map("document_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  role         ParticipantRole
  order        Int                 @default(0)
  status       ParticipantStatus   @default(pending)
  deadline     DateTime?           @db.Timestamptz(3)
  actedAt      DateTime?           @map("acted_at") @db.Timestamptz(3)

  // Tasdiq izohatlari (tasdiqlasa yozsa bo'ladi)
  approvalNotes String?            @map("approval_notes") @db.Text
  // Rad etish izohatlari (rad etsa faqat zarur)
  rejectReason String?             @map("reject_reason") @db.Text
  // Tasdiq usuli (signature, qr, digital, manual)
  approvalMethod String?           @map("approval_method") @db.VarChar(20)

  // QR kod tasdiqqa uchun (noyob har bir tasdiqlashuvchi uchun)
  qrCode       String?             @unique @map("qr_code") @db.VarChar(512)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([documentId, userId, role])
  @@index([userId, status])
  @@index([documentId, order])
  @@map("document_participants")
}

model Resolution {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  text       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User              @relation(fields: [authorId], references: [id])
  targets  ResolutionTarget[]

  @@index([documentId])
  @@map("resolutions")
}

model ResolutionTarget {
  id           String        @id @default(uuid()) @db.Uuid
  resolutionId String        @map("resolution_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  deadline     DateTime?     @db.Timestamptz(3)
  status       EdoTaskStatus @default(pending)
  doneAt       DateTime?     @map("done_at") @db.Timestamptz(3)
  doneNote     String?       @map("done_note") @db.Text

  resolution Resolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([resolutionId])
  @@map("resolution_targets")
}

model DocumentComment {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  text       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([documentId])
  @@map("document_comments")
}

model DocumentAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String?  @map("document_id") @db.Uuid   // yuklash paytida null bo'lishi mumkin
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  filename     String   @db.VarChar(512)
  storedPath   String   @map("stored_path") @db.VarChar(1024)
  sizeBytes    BigInt   @map("size_bytes")
  mimeType     String   @map("mime_type") @db.VarChar(128)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@index([documentId])
  @@map("document_attachments")
}

// E-IMZO imzosi — faqat tashqi chiquvchi hujjatlarda ishlatiladi
model DocumentSignature {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @map("document_id") @db.Uuid
  signerId      String    @map("signer_id") @db.Uuid
  pkcs7Data     Bytes     @map("pkcs7_data")                          // CMS/PKCS#7 imzo blob
  certSerial    String    @map("cert_serial") @db.VarChar(128)
  certSubject   String    @map("cert_subject") @db.VarChar(512)
  certIssuer    String?   @map("cert_issuer") @db.VarChar(512)
  certValidFrom DateTime? @map("cert_valid_from") @db.Timestamptz(3)
  certValidTo   DateTime? @map("cert_valid_to") @db.Timestamptz(3)
  signatureHash String    @map("signature_hash") @db.VarChar(128)     // imzolangan ma'lumot hash'i
  signedAt      DateTime  @default(now()) @map("signed_at") @db.Timestamptz(3)
  verified      Boolean   @default(false)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(3)
  verifyError   String?   @map("verify_error") @db.Text

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer   User     @relation(fields: [signerId], references: [id])

  @@index([documentId])
  @@map("document_signatures")
}

// Hujjat audit jurnali — har bir qadam yozib boriladi
model DocumentAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(64)         // created / sent / approved / rejected / forwarded / signed / commented / overdue
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([action])
  @@index([createdAt])
  @@map("document_audit_log")
}

model DocumentTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  category     String   @db.VarChar(64)
  bodyTemplate String   @map("body_template") @db.Text   // {{placeholder}} bilan
  createdById  String   @map("created_by_id") @db.Uuid
  isShared     Boolean  @default(true) @map("is_shared")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User       @relation(fields: [createdById], references: [id])
  documents Document[]

  @@index([category])
  @@map("document_templates")
}

// ============================================================
// DIREKT CHAT (ichki tarmoq ichida real-vaqt chat)
// ============================================================

model ChatMessage {
  id         String    @id @default(uuid()) @db.Uuid
  fromUserId String    @map("from_user_id") @db.Uuid
  toUserId   String    @map("to_user_id") @db.Uuid
  body       String    @db.Text
  sentAt     DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedForFrom Boolean   @default(false) @map("deleted_for_from")
  deletedForTo   Boolean   @default(false) @map("deleted_for_to")
  deletedForAll  Boolean   @default(false) @map("deleted_for_all")

  fromUser    User             @relation("ChatSender",   fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User             @relation("ChatReceiver", fields: [toUserId],   references: [id], onDelete: Cascade)
  attachments ChatAttachment[]

  @@index([fromUserId, toUserId, sentAt])
  @@index([toUserId, readAt])
  @@map("chat_messages")
}

model ChatAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  filename   String   @db.VarChar(512)
  storedPath String   @map("stored_path") @db.VarChar(512)
  sizeBytes  BigInt   @map("size_bytes")
  mimeType   String   @map("mime_type") @db.VarChar(128)

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("chat_attachments")
}

// ─── Guruh chat ─────────────────────────────────────────────────────────────
model ChatGroup {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(255)
  avatarPath String?  @map("avatar_path") @db.VarChar(512)
  ownerId    String   @map("owner_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner    User               @relation("ChatGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  ChatGroupMember[]
  messages ChatGroupMessage[]

  @@map("chat_groups")
}

model ChatGroupMember {
  id         String    @id @default(uuid()) @db.Uuid
  groupId    String    @map("group_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  isAdmin    Boolean   @default(false) @map("is_admin")
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz(3)
  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("chat_group_members")
}

model ChatGroupMessage {
  id            String    @id @default(uuid()) @db.Uuid
  groupId       String    @map("group_id") @db.Uuid
  fromUserId    String    @map("from_user_id") @db.Uuid
  body          String    @db.Text
  sentAt        DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  editedAt      DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedForAll Boolean   @default(false) @map("deleted_for_all")

  group       ChatGroup               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser    User                    @relation("ChatGroupSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  attachments ChatGroupAttachment[]

  @@index([groupId, sentAt])
  @@map("chat_group_messages")
}

model ChatGroupAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  filename   String   @db.VarChar(512)
  storedPath String   @map("stored_path") @db.VarChar(512)
  sizeBytes  BigInt   @map("size_bytes")
  mimeType   String   @map("mime_type") @db.VarChar(128)

  message ChatGroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("chat_group_attachments")
}

// ============================================================
// KONTAKT GURUHLARI (foydalanuvchi kontaktlarni guruhlash uchun)
// ============================================================
model ContactGroup {
  id        String               @id @default(uuid()) @db.Uuid
  ownerId   String               @map("owner_id") @db.Uuid
  name      String               @db.VarChar(64)
  color     String?              @db.VarChar(16)  // Tailwind color token yoki hex
  owner     User                 @relation("ContactGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   ContactGroupMember[]
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([ownerId, name])
  @@map("contact_groups")
}

model ContactGroupMember {
  groupId  String       @map("group_id") @db.Uuid
  memberId String       @map("member_id") @db.Uuid
  group    ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member   User         @relation("GroupMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@id([groupId, memberId])
  @@map("contact_group_members")
}

// Avto-raqamlash: bo'lim kodi bo'yicha hisoblagich — tartib raqami (01-05, 02-05, ...)
model DocumentCounter {
  id         String @id @default(uuid()) @db.Uuid
  deptCode   String @unique @map("dept_code") @db.VarChar(16)
  lastNumber Int    @default(0) @map("last_number")

  @@map("document_counters")
}

// Yagona ID uchun kunlik hisoblagich — asaka-YYYYMMDDNN
model DocUidCounter {
  day        String @id @db.VarChar(8) // YYYYMMDD
  lastNumber Int    @default(0) @map("last_number")

  @@map("doc_uid_counters")
}

// Tizim sozlamalari — kalit/qiymat (masalan: internal_deadline_days)
model AppSetting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}
